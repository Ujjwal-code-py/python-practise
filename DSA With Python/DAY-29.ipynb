   "source": [
    "### Search in rotated sorted Array\n",
    "\n",
    "nums=list(map(int,input().split()))\n",
    "target=int(input())\n",
    "ans=-1\n",
    "for i in range(len(nums)):\n",
    "    if(nums[i]==target):\n",
    "        ans=i\n",
    "print(ans)\n",
    "    \n",
    "    \n",
    "    \n",
    "        \n"
